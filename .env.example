APP_NAME="Developer Portfolio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=1.0.0

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------------------------------
# Database (optional — not required, file storage is used)
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# -------------------------------------------------------
# Cache & Session (file driver — no Redis needed)
# -------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# -------------------------------------------------------
# Mail
# Set MAIL_MAILER=log during local development to write
# emails to storage/logs/laravel.log instead of sending.
# -------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@devportfolio.local"
MAIL_FROM_NAME="${APP_NAME}"

# Email address that receives new contact notifications
OWNER_EMAIL="owner@example.com"
OWNER_NAME="Portfolio Owner"

# -------------------------------------------------------
# AI Integration (Anthropic Claude)
# Leave ANTHROPIC_API_KEY empty to run without AI.
# The service will use safe fallback values automatically.
# -------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=anthropic
AI_TIMEOUT=30
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# -------------------------------------------------------
# Rate Limiting
# Maximum contact form submissions per minute per IP.
# -------------------------------------------------------
RATE_LIMIT_CONTACT=5

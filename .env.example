APP_NAME="Developer Portfolio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=1.0.0

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------------------------------
# Database (optional — not required, file storage is used)
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# -------------------------------------------------------
# Cache & Session (file driver — no Redis needed)
# -------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# -------------------------------------------------------
# Mail (Mailtrap — https://mailtrap.io)
# Get your API key from Mailtrap → Sending → API Keys.
# MAIL_FROM_ADDRESS must be a verified sender domain in
# your Mailtrap account.
# -------------------------------------------------------
MAILTRAP_API_KEY=your_mailtrap_api_key_here
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email address that receives new contact notifications
OWNER_EMAIL="owner@example.com"
OWNER_NAME="Portfolio Owner"

# -------------------------------------------------------
# AI Integration (Anthropic Claude)
# Leave ANTHROPIC_API_KEY empty to run without AI.
# The service will use safe fallback values automatically.
# -------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=gemini
AI_TIMEOUT=30
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# -------------------------------------------------------
# Rate Limiting
# Maximum contact form submissions per minute per IP.
# -------------------------------------------------------
RATE_LIMIT_CONTACT=5
